{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Downstream Impact Communication",
      "weight": "Bolder",
      "size": "Large",
      "horizontalAlignment": "Center",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Please complete the information below",
      "isSubtle": true,
      "horizontalAlignment": "Center",
      "spacing": "None",
      "wrap": true
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Incident #",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "incidentNumber",
                  "placeholder": "INC123456",
                  "isRequired": true,
                  "errorMessage": "Incident number is required."
                }
              ]
            },
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Incident Status",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.ChoiceSet",
                  "id": "incidentStatus",
                  "style": "compact",
                  "value": "Active",
                  "choices": [
                    {
                      "title": "Active",
                      "value": "Active"
                    },
                    {
                      "title": "Proactive",
                      "value": "Proactive"
                    },
                    {
                      "title": "Resolved",
                      "value": "Resolved"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Time of Occurrence / Discovery",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "Input.Text",
                  "id": "timeOfOccurrence",
                  "placeholder": "2026-08-20 09:45 AM EST"
                }
              ]
            },
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Estimated Time to Recovery",
                  "weight": "Bolder",
                  "wrap": true
                },
                {
                  "type": "Input.Text",
                  "id": "estimatedRecovery",
                  "placeholder": "10:00 AM EST"
                }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Next Update",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "nextUpdate",
                  "placeholder": "09:00 AM EST / N/A"
                }
              ]
            },
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Problem Ticket",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "problemTicket",
                  "placeholder": "PRB123456"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Communication Trigger",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Trigger",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "communicationTrigger",
                  "placeholder": "Enter trigger"
                }
              ]
            },
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Recipients",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "communicationRecipients",
                  "placeholder": "Enter recipients",
                  "isMultiline": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Incident Short Description",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "Input.Text",
          "id": "incidentShortDescription",
          "placeholder": "Enter incident short description",
          "isMultiline": true
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Impacted Apps / Processes",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "Application and Status",
          "weight": "Bolder",
          "spacing": "Small"
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "55",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Application",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "impactedApplication",
                  "placeholder": "Application"
                }
              ]
            },
            {
              "type": "Column",
              "width": "45",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Status",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "impactedApplicationStatus",
                  "placeholder": "Status"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Downstream Impacted Application",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "TextBlock",
          "text": "Add one application at a time.",
          "isSubtle": true,
          "spacing": "Small",
          "wrap": true
        },
        {
          "type": "ColumnSet",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "55",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Application",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "downstreamApplication",
                  "placeholder": "Application",
                  "isRequired": true,
                  "errorMessage": "Application name is required."
                }
              ]
            },
            {
              "type": "Column",
              "width": "45",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Status",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.ChoiceSet",
                  "id": "downstreamStatus",
                  "style": "compact",
                  "placeholder": "Select status",
                  "isRequired": true,
                  "errorMessage": "Please select a status.",
                  "choices": [
                    {
                      "title": "Impacted",
                      "value": "Impacted"
                    },
                    {
                      "title": "To be assessed",
                      "value": "To be assessed"
                    },
                    {
                      "title": "No Impact",
                      "value": "No Impact"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Team to Action",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "teamToAction",
                  "placeholder": "Enter responsible team"
                }
              ]
            },
            {
              "type": "Column",
              "width": "50",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "Current Update",
                  "weight": "Bolder"
                },
                {
                  "type": "Input.Text",
                  "id": "currentUpdate",
                  "placeholder": "Enter current update",
                  "isMultiline": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "emphasis",
      "spacing": "Medium",
      "items": [
        {
          "type": "TextBlock",
          "text": "Additional Technical Details / Notes",
          "weight": "Bolder",
          "size": "Medium"
        },
        {
          "type": "Input.Text",
          "id": "technicalDetails",
          "placeholder": "Enter technical details, dependency information, delays, etc.",
          "isMultiline": true
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "Add Another Application",
      "data": {
        "action": "addApplication"
      }
    },
    {
      "type": "Action.Submit",
      "title": "Done",
      "style": "positive",
      "data": {
        "action": "finishApplications"
      }
    }
  ]
}