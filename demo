trim(
  first(
    skip(
      outputs('Compose_-_Columns'),
      int(
        xpath(
          xml(
            concat(
              '<r><c>',
              replace(
                replace(
                  replace(
                    outputs('Compose_-_Header_Text'),
                    '&',
                    '&amp;'
                  ),
                  '<',
                  '&lt;'
                ),
                '>',
                '&gt;'
              ),
              '</c></r>'
            )
          ),
          'count(/r/c[.="Run ID"]/preceding-sibling::c)'
        )
      )
    )
  )
)