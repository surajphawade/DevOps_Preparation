trim(
    first(
        xpath(
            xml(
                concat(
                    '<r>',
                    '<h><c>',
                    join(outputs('Compose_-_Headers'), '</c><c>'),
                    '</c></h>',
                    '<d><c>',
                    join(outputs('Compose_-_Columns'), '</c><c>'),
                    '</c></d>',
                    '</r>'
                )
            ),
            '/r/d/c[position() = count(/r/h/c[normalize-space(.)="Run ID"]/preceding-sibling::c)+1]'
        )
    )
)