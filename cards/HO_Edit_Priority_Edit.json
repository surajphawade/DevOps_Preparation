{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "✏️ Edit Priority",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "id",
      "label": "Priority ID",
      "placeholder": "Example: P001"
    },
    {
      "type": "Input.Text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "Input.Text",
      "id": "description",
      "label": "Description",
      "isMultiline": true
    },
    {
      "type": "Input.Text",
      "id": "owner",
      "label": "Owner"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "priority",
      "label": "Priority",
      "choices": [
        {
          "title": "High",
          "value": "High"
        },
        {
          "title": "Medium",
          "value": "Medium"
        },
        {
          "title": "Low",
          "value": "Low"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "status",
      "label": "Status",
      "choices": [
        {
          "title": "Active",
          "value": "Active"
        },
        {
          "title": "Closed",
          "value": "Closed"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "💾 Save Changes",
      "data": {
        "action": "editPriority"
      }
    }
  ]
}