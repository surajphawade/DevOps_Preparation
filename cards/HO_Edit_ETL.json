{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "⚙️ Update ETL",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "Select a group and enter the latest handover update.",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "Input.ChoiceSet",
      "id": "etlGroup",
      "label": "Group",
      "value": "Group 1",
      "choices": [
        {
          "title": "Group 1",
          "value": "Group 1"
        },
        {
          "title": "Group 2",
          "value": "Group 2"
        },
        {
          "title": "Group 3",
          "value": "Group 3"
        },
        {
          "title": "Group 4",
          "value": "Group 4"
        },
        {
          "title": "Group 5",
          "value": "Group 5"
        }
      ]
    },
    {
      "type": "Input.Text",
      "id": "etlUpdate",
      "label": "ETL Update",
      "placeholder": "Example: Salesforce - 34/34 Jobs Completed. Please Monitor",
      "isMultiline": true,
      "maxLength": 2000
    },
    {
      "type": "TextBlock",
      "text": "Tip: keep all application/job updates for the selected group in this field, one line per item.",
      "isSubtle": true,
      "wrap": true
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "💾 Save ETL Update",
      "data": {
        "action": "saveETL"
      }
    }
  ]
}