{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "🟠 Update RITM",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "id",
      "label": "RITM ID",
      "placeholder": "Example: R001"
    },
    {
      "type": "Input.Text",
      "id": "ritm",
      "label": "RITM Number",
      "placeholder": "Example: RITM123456"
    },
    {
      "type": "Input.Text",
      "id": "description",
      "label": "Description",
      "isMultiline": true
    },
    {
      "type": "Input.Text",
      "id": "owner",
      "label": "Owner"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "status",
      "label": "Status",
      "choices": [
        {
          "title": "Pending",
          "value": "Pending"
        },
        {
          "title": "Completed",
          "value": "Completed"
        },
        {
          "title": "Closed",
          "value": "Closed"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "💾 Save RITM",
      "data": {
        "action": "saveRITM"
      }
    }
  ]
}