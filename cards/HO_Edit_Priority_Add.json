{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.3",
  "body": [
    {
      "type": "TextBlock",
      "text": "🔴 Add Priority",
      "size": "Large",
      "weight": "Bolder",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "title",
      "label": "Title",
      "placeholder": "Example: MFOCRE",
      "maxLength": 200
    },
    {
      "type": "Input.Text",
      "id": "description",
      "label": "Description",
      "placeholder": "Enter the priority/update",
      "isMultiline": true,
      "maxLength": 1000
    },
    {
      "type": "Input.Text",
      "id": "owner",
      "label": "Owner",
      "placeholder": "Enter owner",
      "maxLength": 100
    },
    {
      "type": "Input.ChoiceSet",
      "id": "priority",
      "label": "Priority",
      "value": "High",
      "choices": [
        {
          "title": "High",
          "value": "High"
        },
        {
          "title": "Medium",
          "value": "Medium"
        },
        {
          "title": "Low",
          "value": "Low"
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "status",
      "label": "Status",
      "value": "Active",
      "choices": [
        {
          "title": "Active",
          "value": "Active"
        },
        {
          "title": "Closed",
          "value": "Closed"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "💾 Save Priority",
      "data": {
        "action": "addPriority"
      }
    }
  ]
}